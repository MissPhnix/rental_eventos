from flask import Flask
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy.orm import DeclarativeBase

app = Flask(__name__)
app.config["SQLALCHEMY_DATABASE_URI"] = "postgresql://postgres:aluno@localhost/rental_db"

class Base(DeclarativeBase):
    pass

db = SQLAlchemy(model_class=Base)

db.init_app(app)

with app.app_context():
    db.reflect()

class Usuario(db.Model):
    __table__ = db.metadata.tables["usuario"]

class Equipamento(db.Model):
    __table__ = db.metadata.tables["equipamento"]

class Movimentacao(db.Model):
    __table__ = db.metadata.tables["movimentacao"]

# métodos
@app.route("/login", methods=["GET"])
def login(email: str, senha: str):
    user = db.get(Usuario, email, senha)
    if user:
        return "Login efetuado com sucesso!"
    return "Erro: E-mail ou Senha incorretos. Tente novamente ou crie uma conta."

