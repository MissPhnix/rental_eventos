@app.post("/equipamento")
def criarEquipamento(e: ModelEquipamento):
    conexao = SessionLocal()
    novoEquipamento = Equipamento(**e.dict())
    conexao.add(novoEquipamento)
    conexao.commit()
    conexao.refresh(novoEquipamento)
    conexao.close()
